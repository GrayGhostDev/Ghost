# =============================================================================
# Ghost Backend Framework — PRODUCTION Environment Template
# =============================================================================
# GGDC-System Level 2 service. Referenced by docs/DEPLOYMENT_GUIDE.md:
#   cp .env.production.example .env
#
# Secrets source: 1Password vault "GGDC / ghost-backend", or GCP Secret Manager
# via GCP_SECRET_PROJECT below. Never commit a filled-in copy of this file.
#
# Every CHANGE_ME below is mandatory. ENVIRONMENT=production makes
# tools/docker_entrypoint.py refuse to boot without JWT_SECRET, API_KEY and
# DB_PASSWORD, rather than silently falling back to framework defaults.
# =============================================================================

# ── Basic Settings ─────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=Ghost Backend
VERSION=1.0.0

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Prefer DATABASE_URL in production — it overrides all individual DB_* vars.
# The app converts postgresql:// to postgresql+psycopg:// internally (psycopg v3).
DATABASE_URL=postgresql://USER:CHANGE_ME@HOST:5432/ghost  # pragma: allowlist secret
DB_DRIVER=postgresql
#
# Connection pool (see CLAUDE.md "Connection Pooling")
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME

# ── API Configuration ─────────────────────────────────────────────────────
# 0.0.0.0 is correct inside a container; external exposure is Traefik's job.
# Never publish this port on 0.0.0.0 at the host level.
API_HOST=0.0.0.0
API_PORT=8801
WORKERS=4
API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Application module ─────────────────────────────────────────────────────
# Declare the served app explicitly. Left unset, docker_entrypoint.py infers it
# from whether examples/simple_api.py happens to exist in the image — which is
# how a demo app ends up serving production traffic.
APP_MODULE=examples.simple_api:app

# ── External API Keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
GITHUB_PAT=
BRAVE_API_KEY=
SENDGRID_API_KEY=
SENTRY_DSN=

# ── GCP (Secret Manager overlay) ──────────────────────────────────────────
# When set, src/ghost/gcp_secrets.py fills EMPTY/default fields only —
# environment variables always take precedence.
# GCP_SECRET_PROJECT=sylvan-flight-476922-m7

# ── Observability ──────────────────────────────────────────────────────────
# gRPC protocol (port 4317). Do NOT use 4318 (HTTP) — Python SDK uses gRPC exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ghost-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ggdc,deployment.environment=production

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
